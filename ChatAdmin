	[PunRPC]
	private void ReceiveMessage(string message)
	{
		if (messages.Count > maxMessages)
		{
			messages.Remove(messages[0]);
			Object.Destroy((Object)(object)messages[0]);
		}
		GameObject val = Object.Instantiate<GameObject>(messageTemplate, messageParentObj.transform);
		val.GetComponentInChildren<Text>().text = message;
		messages.Add(val);
		verticalScroll.value = 0f;
	}

