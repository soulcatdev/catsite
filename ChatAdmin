	private void Start()
	{
		ourPrefix = PlayerPrefs.GetString("OurPrefix");
		ourNickname = PhotonNetwork.NickName;
		mutedForSeconds = PlayerPrefs.GetFloat("Muted");
		if (mutedForSeconds > 0f)
		{
			sendMessage.SetActive(false);
			YouAreMuted.SetActive(true);
		}
		if (PlayerPrefs.GetInt("HideChat") == 1)
		{
			((Component)chatObj).gameObject.SetActive(false);
		}
	}

	private void Update()
	{
		if (mutedForSeconds > 0f)
		{
			YouAreMuted.SetActive(true);
			sendMessage.SetActive(false);
			mutedForSeconds -= Time.deltaTime;
		}
		else if (!sendMessage.activeSelf)
		{
			YouAreMuted.SetActive(false);
			sendMessage.SetActive(true);
		}
	}

	public void DeathLog(string attacker)
	{
		if (lastDeathLog == string.Empty)
		{
			lastDeathLog = attacker + " killed " + ourNickname;
			((Component)this).gameObject.GetComponent<PhotonView>().RPC("ReceiveMessage", (RpcTarget)0, new object[1] { lastDeathLog });
			lastDeathLog = string.Empty;
		}
	}

